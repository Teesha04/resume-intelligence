# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# LLM (OPTIONAL). If no key is present the pipeline runs in deterministic-only
# mode: rule-based extraction + rule-based scoring. Nothing crashes.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Keep under the provider's free-tier requests-per-minute quota.
LLM_REQUESTS_PER_MINUTE=12

# ---------------------------------------------------------------------------
# GitHub (OPTIONAL). Without a token the public API allows ~60 req/hour,
# which is enough for a slow run but can hit rate limits on 50 resumes.
# With a token: 5000 req/hour.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Runtime knobs
# ---------------------------------------------------------------------------
MAX_CONCURRENCY=5          # bounded concurrency for LLM + GitHub calls
REQUEST_TIMEOUT_SECONDS=20
CACHE_DIR=.cache           # on-disk cache for LLM + GitHub responses
LOG_LEVEL=INFO
